{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "tailwind.config.js",
    "scripts",
    "src/config/siteMode.ts",
    "src/data/portalData.ts",
    "src/i18n/language.ts",
    "src/utils/content.ts"
  ]
}
